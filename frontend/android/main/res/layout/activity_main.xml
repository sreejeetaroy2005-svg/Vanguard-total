<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:padding="24dp">

    <TextView
        android:id="@+id/titleHUD"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="VANGUARD: LIFELINE HUD"
        android:textColor="#00FF00"
        android:textSize="14sp"
        android:fontFamily="monospace"
        android:layout_centerHorizontal="true" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#00FF00"
        android:layout_below="@id/titleHUD"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/meshStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MESH NETWORK: INITIALIZING..."
        android:textColor="#AAAAAA"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnSOS"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_centerInParent="true"
        android:background="@android:color/transparent"
        android:text="TRIGGER\nSOS"
        android:textColor="#FF0000"
        android:textSize="32sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="20dp" />
        
    <!-- Decorative Pulse Circles would go here in code -->

</RelativeLayout>
